rules_version = '2';

// Pagewise — every user can only read/write their own data.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // New profiles always start on the free plan.
      allow create: if isOwner(uid) && request.resource.data.plan == 'free';
      // Users can edit their name and stats, but never their own plan.
      // (Upgrades must be written by a trusted server, e.g. a purchase webhook.)
      allow update: if isOwner(uid) && request.resource.data.plan == resource.data.plan;
      allow delete: if false;

      match /documents/{docId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /notifications/{noticeId} {
        allow read, write: if isOwner(uid);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
