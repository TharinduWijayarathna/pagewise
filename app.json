{
  "expo": {
    "name": "Pagewise",
    "slug": "pagewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pagewise.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A2824",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pagewise.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F2ECE0"
        }
      ],
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "kotlinVersion": "2.3.21"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pagewise uses the microphone so you can ask questions about your documents by voice.",
          "speechRecognitionPermission": "Pagewise turns your speech into text so you can ask questions hands-free.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "react-native-blob-util",
      "expo-sharing",
      "@bacons/apple-targets",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          },
          "iosShareExtensionName": "Ask Pagewise",
          "iosAppGroupIdentifier": "group.com.pagewise.app",
          "androidIntentFilters": [
            "application/pdf"
          ]
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Pagewise uses the camera to scan paper documents into PDFs you can ask questions about."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Pagewise adds deadlines from your documents to your calendar when you ask it to."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Upcoming",
              "label": "Pagewise: Coming up",
              "description": "Deadlines from your documents and flashcards to review.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen|keyguard"
            }
          ]
        }
      ]
    ],
    "scheme": "pagewise",
    "experiments": {
      "typedRoutes": true
    }
  }
}
