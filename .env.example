# Copy this file to `.env` and fill in the values (see docs/firebase-setup.md).

# Web client ID for Google Sign-In (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: App Check debug token for development builds (Firebase console → App Check → Apps → ⋮ → Manage debug tokens).
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
